# Local development
APP_NAME=assignment-for-6700
APP_ENVIRONMENT=development
APP_DEBUG=true
APP_MODEL_PATH=models/digits.joblib

# Model backend: "echo" needs no server. Switch to "openai" once Ollama is running.
LLM_PROVIDER=echo
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:1.5b-instruct

# Ingestion: raw pulls and records go under this folder (gitignored)
INGEST_DATA_DIR=data

# Enable after starting Qdrant, loading a catalog and selecting a real LLM.
GENERATION_ENABLED=false
GENERATION_MAX_CONTEXT_CHARS=6000
QDRANT_URL=http://localhost:6333
QDRANT_ALIAS=provisions
SEARCH_K=3
SEARCH_MIN_RELEVANCE=0.65
