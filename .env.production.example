# Deployment environment.
APP_NAME=assignment-for-6700
APP_ENVIRONMENT=production
APP_DEBUG=false

# Model backend: the Ollama container on the compose network.
LLM_PROVIDER=openai
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:1.5b-instruct
LLM_TIMEOUT_S=120
LLM_DEVICE=cpu
LLM_CACHE_DIR=/models
# Hosted fallback instead: set LLM_BASE_URL to the provider's /v1 URL and LLM_API_KEY.
