# Settings for the Compose stack on TEAM02. Every setting the code reads is listed,
# in the same order as .env.local.example. Secrets never go here: put them, and any
# override, in the untracked .env (its values win).

# App
APP_NAME=assignment-for-6700
APP_ENVIRONMENT=production
APP_DEBUG=false
APP_RATE_LIMIT_ASK_PER_MINUTE=10
APP_RATE_LIMIT_RETRIEVE_PER_MINUTE=30
APP_LOG_JSON=true
APP_LOG_LEVEL=INFO
# APP_ADMIN_API_KEY=  (secret, at least 32 characters; only in the untracked .env)

# Model backend
LLM_PROVIDER=openai
LLM_BASE_URL=http://llm:8080/v1
LLM_MODEL=qwen2.5-1.5b-instruct
# LLM_API_KEY=  (secret, only for a hosted API; only in the untracked .env)
LLM_TIMEOUT_S=120
LLM_CONNECT_TIMEOUT_S=5
LLM_MAX_RETRIES=3
LLM_RETRY_MAX_WAIT_S=10
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0
LLM_DEVICE=cpu
LLM_CACHE_DIR=/models

# Answers (/ask)
GENERATION_ENABLED=true
GENERATION_MAX_CONTEXT_CHARS=6000
GENERATION_MAX_CONCURRENT=2
GENERATION_QUEUE_TIMEOUT_S=60

# Vector database and search
QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=  (secret, only if Qdrant needs one; only in the untracked .env)
QDRANT_ALIAS=provisions
QDRANT_TIMEOUT_S=5
EMBED_DENSE_MODEL=BAAI/bge-small-en-v1.5
EMBED_SPARSE_MODEL=Qdrant/bm25
EMBED_CACHE_DIR=/embed-cache
EMBED_BATCH_SIZE=64
SEARCH_K=3
SEARCH_CANDIDATE_K=50
SEARCH_MIN_RELEVANCE=0.65
SEARCH_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
SEARCH_RERANK_CANDIDATES=20
SEARCH_MIN_RERANK=-1.0

# Ingestion
INGEST_DATA_DIR=/data
INGEST_ECFR_BASE_URL=https://www.ecfr.gov/
INGEST_ECFR_PARTS='["8 CFR 214", "8 CFR 274a", "22 CFR 41", "22 CFR 62"]'
INGEST_ECFR_SINCE=2020-01-01
INGEST_FEDERAL_REGISTER_BASE_URL=https://www.federalregister.gov/api/v1
INGEST_FEDERAL_REGISTER_SINCE=2020-01-01
INGEST_USER_AGENT='dsan6700-ingest (Georgetown DSAN student project)'
INGEST_REQUEST_TIMEOUT_S=30
INGEST_MIN_REQUEST_INTERVAL_S=1
INGEST_MAX_RETRIES=3

# Backups (docs/runbook.md#back-up-and-restore)
BACKUP_GITHUB_REPO=RAkupper/Assignment_for_6700
# BACKUP_GITHUB_TOKEN=  (secret; only in the untracked .env.backup, which only jobs reads)
BACKUP_KEEP=5
BACKUP_TAG_PREFIX=data-
BACKUP_TIMEOUT_S=300

# Read by Compose itself from .env, not by the app (compose.yml):
# APP_IMAGE: set by scripts/deploy.sh to the release digest; default assignment_for_6700-app (a local build)
# APP_BIND: address the app's port 8000 binds on the host; default 127.0.0.1
# COMPOSE_PROFILES: proxy,monitoring on TEAM02: Caddy for HTTPS, Prometheus and Grafana
# APP_DOMAIN: team02.cis240466.projects.jetstream-cloud.org on TEAM02; default localhost
# FORWARDED_ALLOW_IPS: * behind Caddy, so rate limits see the real client; default 127.0.0.1
# LLM_HF_REPO: model weights llama.cpp downloads; default Qwen/Qwen2.5-1.5B-Instruct-GGUF:Q4_K_M
# LLM_CTX_SIZE: llama.cpp context for all slots together; default 8192
# LLM_PARALLEL: llama.cpp answer slots; default 2, keep equal to GENERATION_MAX_CONCURRENT
# LLM_MEM_LIMIT: memory cap for the llm container; default 3g
# JOBS_CPUS: CPU cap for one-off jobs, so a load leaves the app room; default 1
# QDRANT_JOBS_TIMEOUT_S: Qdrant time limit for jobs (bulk loads, snapshots); default 60
# GRAFANA_ADMIN_PASSWORD: Grafana's admin login (secret, only in .env); viewing needs none
