# Deployment environment.
APP_NAME=assignment-for-6700
APP_ENVIRONMENT=production
APP_DEBUG=false
APP_RATE_LIMIT_ASK_PER_MINUTE=10
APP_RATE_LIMIT_RETRIEVE_PER_MINUTE=30
# Secrets and the HTTPS setup go in the untracked .env, not here:
# APP_ADMIN_API_KEY, COMPOSE_PROFILES=proxy, APP_DOMAIN, FORWARDED_ALLOW_IPS=*

# Model backend: the llama.cpp container (service "llm") on the compose network.
LLM_PROVIDER=openai
LLM_BASE_URL=http://llm:8080/v1
LLM_MODEL=qwen2.5-1.5b-instruct
LLM_TIMEOUT_S=120
LLM_MAX_TOKENS=256
LLM_DEVICE=cpu
LLM_CACHE_DIR=/models
# Class model server instead: LLM_BASE_URL=http://10.1.82.181:8000/v1 and
# LLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ. Hosted API: its /v1 URL and LLM_API_KEY.

# Ingestion: /data is the catalog-data volume (compose.yml)
INGEST_DATA_DIR=/data

# Enable retrieval-grounded /ask in the unified Compose stack.
GENERATION_ENABLED=true
GENERATION_MAX_CONTEXT_CHARS=6000
GENERATION_MAX_CONCURRENT=2
GENERATION_QUEUE_TIMEOUT_S=60

# Team vectordb settings, shared by the loader and API.
# Import the real catalog with: --catalog /data/catalog.sqlite --activate
QDRANT_URL=http://qdrant:6333
QDRANT_ALIAS=provisions
EMBED_DENSE_MODEL=BAAI/bge-small-en-v1.5
EMBED_SPARSE_MODEL=Qdrant/bm25
SEARCH_K=3
SEARCH_MIN_RELEVANCE=0.65
