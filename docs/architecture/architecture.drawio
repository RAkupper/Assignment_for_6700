geometry"/></mxCell><mxCell id="solution-fe-st" value="&lt;b&gt;&lt;font style=&quot;font-size: 11.5px&quot; color=&quot;#1F6B3A&quot;&gt;built&lt;/font&gt;&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F4E8;strokeColor=#3C9A5F;fontColor=#1A1A1A;fontSize=12;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="solution-1"><mxGeometry x="303" y="375" width="46" height="19" as="geometry"/></mxCell><mxCell id="solution-wf" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BBBBBB;fontColor=#1A1A1A;fontSize=12;strokeWidth=1.2;fontFamily=Helvetica;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="solution-1"><mxGeometry x="78" y="418" width="266" height="236" as="geometry"/></mxCell><mxCell id="solution-wf-input" value="&lt;font style=&quot;font-size: 13px&quot; color=&quot;#555555&quot;&gt;Can I work on campus?&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#555555;fontSize=13;strokeWidth=1.2;fontFamily=Helvetica;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="solution-1"><mxGeometry x="88" y="430" width="186" height="32" as="geometry"/></mxCell><mxCell id="solution-wf-btn" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot; color=&quot;#FFFFFF&quot;&gt;Ask&lt;/font&gt;&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2F6FDE;strokeColor=#2F6FDE;fontColor=#1A1A1A;fontSize=12;strokeWidth=1.2;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="solution-1"><mxGeometry x="280" y="430" width="54" height="32" as="geometry"/></mxCell><mxCell id="solution-wf-answer" value="&lt;font style=&quot;font-size: 13px&quot; color=&quot;#1A1A1A&quot;&gt;F-1 students can work on campus&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#1A1A1A&quot;&gt;up to 20 hours a week while school&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#1A1A1A&quot;&gt;is in session. Confirm with your DSO.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDDDDD;fontColor=#1A1A1A;fontSize=13;strokeWidth=1.2;fontFamily=Helvetica;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="solution-1"><mxGeometry x="88" y="472" width="246" height="88" as="geometry"/></mxCell><mxCell id="solution-wf-source" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#1A1A1A&quot;&gt;[1] 8 CFR 214.2(f)(9)(i)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12.5px&quot; color=&quot;#1A1A1A&quot;&gt;On-campus employment&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12.5px&quot; color=&quot;#1A1A1A&quot;&gt;in force · View on eCFR ↗&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F7FC;strokeColor=#C5D5EA;fontColor=#1A1A1A;fontSize=12.5;strokeWidth=1.2;fontFamily=Helvetica;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="solution-1"><mxGeometry x="88" y="570" width="246" height="72" as="geometry"/></mxCell><mxCell id="solution-fe-note" value="&lt;font style=&quot;font-size: 13px&quot; color=&quot;#1A1A1A&quot;&gt;sketch of the live page; slow or&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#1A1A1A&quot;&gt;failed answers get a plain message&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#1A1A1A;fontSize=13;strokeWidth=1.2;fontFamily=Helvetica;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="solution-1"><mxGeometry x="78" y="662" width="266" height="50" as="geometry"/></mxCell><mxCell id="solution-api" value="&lt;b&gt;&lt;font style=&quot;font-size: 17px&quot; colo