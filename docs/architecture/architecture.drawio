&lt;b&gt;&lt;font style=&quot;font-size: 11.5px&quot; color=&quot;#4A4A4A&quot;&gt;not built&lt;/font&gt;&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#9A9A9A;fontColor=#1A1A1A;fontSize=12;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;dashed=1;dashPattern=6 4;" vertex="1" parent="technical-1"><mxGeometry x="1329" y="19" width="66" height="19" as="geometry"/></mxCell><mxCell id="technical-browser" value="&lt;b&gt;&lt;font style=&quot;font-size: 16px&quot; color=&quot;#1A1A1A&quot;&gt;User's browser&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 14px&quot; color=&quot;#1A1A1A&quot;&gt;student or DSO&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 14px&quot; color=&quot;#1A1A1A&quot;&gt;gives up after 210 s&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#777777;fontColor=#1A1A1A;fontSize=14;strokeWidth=1.2;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="technical-1"><mxGeometry x="14" y="112" width="196" height="84" as="geometry"/></mxCell><mxCell id="technical-le" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px&quot; color=&quot;#1A1A1A&quot;&gt;Let's Encrypt&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#1A1A1A&quot;&gt;TLS certificate (ACME)&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#1A1A1A;fontSize=13;strokeWidth=1.2;fontFamily=Helvetica;align=center;verticalAlign=middle;dashed=1;dashPattern=6 4;" vertex="1" parent="technical-1"><mxGeometry x="14" y="214" width="196" height="60" as="geometry"/></mxCell><mxCell id="technical-limits" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px&quot; color=&quot;#1A1A1A&quot;&gt;Time limits, outside in&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#1A1A1A&quot;&gt;page: 210 s&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#1A1A1A&quot;&gt;Caddy → app: 200 s&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#1A1A1A&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(connect 5 s)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#1A1A1A&quot;&gt;model slot queue: 60 s&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#1A1A1A&quot;&gt;model call: 120 s,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#1A1A1A&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;retries included&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#1A1A1A&quot;&gt;Qdrant: client&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#1A1A1A&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;default (5 s)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#1A1A1A&quot;&gt;eCFR fetch: 30 s,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#1A1A1A&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;retried with backoff&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#1A1A1A&quot;&gt;Each layer gives up&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#1A1A1A&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;after the one inside it&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8EE;strokeColor=#E0A55A;fontColor=#1A1A1A;fontSize=13;strokeWidth=1.2;fontFamily=Helvetica;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="technical-1"><mxGeometry x="14" y="300" width="196" height="236" as="geometry"/></mxCell><mxCell id="technical-ecfr" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px&quot; color=&quot;#1A1A1A&quot;&gt;eCFR API&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#1A1A1A&quot;&gt;8 CF