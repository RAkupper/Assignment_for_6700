&lt;/font&gt;&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1D6;strokeColor=#D9930D;fontColor=#1A1A1A;fontSize=12;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="solution-1"><mxGeometry x="569" y="677" width="82" height="19" as="geometry"/></mxCell><mxCell id="solution-be" value="&lt;b&gt;&lt;font style=&quot;font-size: 17px&quot; color=&quot;#1A1A1A&quot;&gt;Backend (inside the app)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#555555&quot;&gt;Qdrant and the LLM are internal services&lt;/font&gt;&lt;/i&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C4A2;fontColor=#1A1A1A;fontSize=12;strokeWidth=1.2;fontFamily=Helvetica;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="solution-1"><mxGeometry x="680" y="368" width="430" height="352" as="geometry"/></mxCell><mxCell id="solution-b1" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px&quot; color=&quot;#1A1A1A&quot;&gt;1. Retrieve&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;BGE + BM25 hybrid, RRF, top 3; visa, date filters&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F6FBF7;strokeColor=#BBDCC5;fontColor=#1A1A1A;fontSize=13.5;strokeWidth=1.2;fontFamily=Helvetica;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="solution-1"><mxGeometry x="692" y="412" width="406" height="50" as="geometry"/></mxCell><mxCell id="solution-b1-st" value="&lt;b&gt;&lt;font style=&quot;font-size: 11.5px&quot; color=&quot;#1F6B3A&quot;&gt;built&lt;/font&gt;&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F4E8;strokeColor=#3C9A5F;fontColor=#1A1A1A;fontSize=12;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="solution-1"><mxGeometry x="1045" y="419" width="46" height="19" as="geometry"/></mxCell><mxCell id="solution-b2" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px&quot; color=&quot;#1A1A1A&quot;&gt;2. Relevance gate&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;nothing with cosine ≥ 0.65 → &quot;not covered&quot;&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F6FBF7;strokeColor=#BBDCC5;fontColor=#1A1A1A;fontSize=13.5;strokeWidth=1.2;fontFamily=Helvetica;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="solution-1"><mxGeometry x="692" y="474" width="406" height="50" as="geometry"/></mxCell><mxCell id="solution-b2-st" value="&lt;b&gt;&lt;font style=&quot;font-size: 11.5px&quot; color=&quot;#1F6B3A&quot;&gt;built&lt;/font&gt;&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F4E8;strokeColor=#3C9A5F;fontColor=#1A1A1A;fontSize=12;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="solution-1"><mxGeometry x="1045" y="481" width="46" height="19" as="geometry"/></mxCell><mxCell id="solution-b3" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px&quot; color=&quot;#1A1A1A&quot;&gt;3. Wait for a model slot&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;2 slots; after 60 s → passages only&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F6FBF7;strokeColor=#BBDCC5;fontColor=#1A1A1A;fontSize=13.5;strokeWidth=1.2;fontFamily=Helvetica;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="solution-1"><mxGeometry x="692" y="536" width="406" height="50" as="geometry"/></mxCell><mxCell id="solution-b3-st" value="&lt;b&gt;&lt;font style=&quot;font-size: 11.5px&quot; color=&quot;#1F6B3A&quot;&gt;built&lt;/font&gt;&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F4E8;strokeColor=#3C9A5F;fontColor=#1A1A1A;fontSize=12;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="solution-1"><mxGeometry x="1045" y="543" width="46" height="19" as="geometry"/></mxCell><mxCell id="solution-b4" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px&quot; color=&quot;#1A1A1A&quot;&gt;4. Generate&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;Qwen2.5-1.5B, answer only from the passages&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F6FBF7;strokeColor=#BBDCC5;fontColor=#1A1A1A;fontSize=13.5;strokeWidth=1.2;fontFamily=Helvetica;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="solution-1"><mxGeometry x="692" y="598" width="406" height="50" as="geometry"/></mxCell><mxCell id="solution-b4-st" value="&lt;b&gt;&lt;font style=&quot;font-size: 11.5px&quot; color=&quot;#1F6B3A&quot;&gt;built&lt;/font&gt;&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F4E8;strokeColor=#3C9A5F;fontColor=#1A1A1A;fontSize=12;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="solution-1"><mxGeometry x="1045" y="605" width="46" height="19" as="geometry"/></mxCell><mxCell id="solution-b5" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px&quot; color=&quot;#1A1A1A&quot;&gt;5. Check the answer&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;every [n] is a hit; claims backed by text&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F6FBF7;strokeColor=#BBDCC5;fontColor=#1A1A1A;fontSize=13.5;strokeWidth=1.2;fontFamily=Helvetica;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;dashed=1;dashPattern=6 4;" vertex="1" parent="solution-1"><mxGeometry x="692" y="660" width="406" height="50" as="geometry"/></mxCell><mxCell id="solution-b5-st" value="&lt;b&gt;&lt;font style=&quot;font-size: 11.5px&quot; color=&quot;#4A4A4A&quot;&gt;not built&lt;/font&gt;&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#9A9A9A;fontColor=#1A1A1A;fontSize=12;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="solution-1"><mxGeometry x="1025" y="667" width="66" height="19" as="geometry"/></mxCell><mxCell id="solution-eval" value="&lt;b&gt;&lt;font style=&quot;font-size: 16px&quot; color=&quot;#1A1A1A&quot;&gt;Evaluation&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;25 questions with known answers:&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;10 from HW3 testers, 11 common&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;F/M/J questions, 4 to decline&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;Expected provisions checked&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;against the eCFR text&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;Baseline (build testers used):&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;19/25 pass · source found 16/20&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;inline citations 0/19&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;Runs after every deploy;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;each fix is measured against it&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;Failures trace to root causes (#57)&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C4A2;fontColor=#1A1A1A;fontSize=13.5;strokeWidth=1.2;fontFamily=Helvetica;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="solution-1"><mxGeometry x="1122" y="368" width="306" height="352" as="geometry"/></mxCell><mxCell id="solution-eval-st" value="&lt;b&gt;&lt;font style=&quot;font-size: 11.5px&quot; color=&quot;#1F6B3A&quot;&gt;built&lt;/font&gt;&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F4E8;strokeColor=#3C9A5F;fontColor=#1A1A1A;fontSize=12;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="solution-1"><mxGeometry x="1375" y="375" width="46" height="19" as="geometry"/></mxCell><mxCell id="solution-st0" value="&lt;b&gt;&lt;font style=&quot;font-size: 16px&quot; color=&quot;#1A1A1A&quot;&gt;Code, releases, config&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#555555&quot;&gt;GitHub · GHCR · .env on TEAM02&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;• issue → branch → PR → review → merge&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;• CI: ruff, mypy, pytest, gitleaks,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;image smoke test, push to GHCR&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;• release = version + tag + image;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;TEAM02 runs it pinned by digest&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;• secrets only in .env; no accounts&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0B98A;fontColor=#1A1A1A;fontSize=13.5;strokeWidth=1.2;fontFamily=Helvetica;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="solution-1"><mxGeometry x="66" y="752" width="330" height="226" as="geometry"/></mxCell><mxCell id="solution-st0-st" value="&lt;b&gt;&lt;font style=&quot;font-size: 11.5px&quot; color=&quot;#1F6B3A&quot;&gt;built&lt;/font&gt;&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F4E8;strokeColor=#3C9A5F;fontColor=#1A1A1A;fontSize=12;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="solution-1"><mxGeometry x="343" y="759" width="46" height="19" as="geometry"/></mxCell><mxCell id="solution-st1" value="&lt;b&gt;&lt;font style=&quot;font-size: 16px&quot; color=&quot;#1A1A1A&quot;&gt;Documents and vectors&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#555555&quot;&gt;named volumes on the 40 GB volume&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;• catalog-data: raw eCFR responses +&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;catalog.sqlite, the source of truth&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;• qdrant-storage: provisions_vN behind&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;an alias; rebuilt from the catalog&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;• full rebuild from eCFR: ~25 min&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;• migrations back the catalog up first&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0B98A;fontColor=#1A1A1A;fontSize=13.5;strokeWidth=1.2;fontFamily=Helvetica;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="solution-1"><mxGeometry x="408" y="752" width="330" height="226" as="geometry"/></mxCell><mxCell id="solution-st1-st" value="&lt;b&gt;&lt;font style=&quot;font-size: 11.5px&quot; color=&quot;#1F6B3A&quot;&gt;built&lt;/font&gt;&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F4E8;strokeColor=#3C9A5F;fontColor=#1A1A1A;fontSize=12;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="solution-1"><mxGeometry x="685" y="759" width="46" height="19" as="geometry"/></mxCell><mxCell id="solution-st2" value="&lt;b&gt;&lt;font style=&quot;font-size: 16px&quot; color=&quot;#1A1A1A&quot;&gt;Models and certificate&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#555555&quot;&gt;named volumes&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;• llm-models: Qwen weights (1.1 GB)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;• embed-cache: BGE + BM25 (~70 MB)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;• caddy-data: TLS certificate,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;renewed automatically&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;• images pinned by digest; swap the&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;model with .env and a restart&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0B98A;fontColor=#1A1A1A;fontSize=13.5;strokeWidth=1.2;fontFamily=Helvetica;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="solution-1"><mxGeometry x="750" y="752" width="330" height="226" as="geometry"/></mxCell><mxCell id="solution-st2-st" value="&lt;b&gt;&lt;font style=&quot;font-size: 11.5px&quot; color=&quot;#1F6B3A&quot;&gt;built&lt;/font&gt;&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F4E8;strokeColor=#3C9A5F;fontColor=#1A1A1A;fontSize=12;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="solution-1"><mxGeometry x="1027" y="759" width="46" height="19" as="geometry"/></mxCell><mxCell id="solution-st3" value="&lt;b&gt;&lt;font style=&quot;font-size: 16px&quot; color=&quot;#1A1A1A&quot;&gt;Backups, logs, metrics&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size: 13px&quot; color=&quot;#555555&quot;&gt;off the instance&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;• catalog + Qdrant snapshot → GitHub&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;release; restore checks before it&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;replaces anything (#55)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;• JSON logs with a request id;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;no question text, no keys&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13.5px&quot; color=&quot;#1A1A1A&quot;&gt;• /metrics → Prometheus → Grafana&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0B98A;fontColor=#1A1A1A;fontSize=13.5;strokeWidth=1.2;fontFamily=Helvetica;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="solution-1"><mxGeometry x="1092" y="752" width="330" height="226" as="geometry"/></mxCell><mxCell id="solution-st3-st" value="&lt;b&gt;&lt;font style=&quot;font-size: 11.5px&quot; color=&quot;#7A4F00&quot;&gt;in progress&lt;/font&gt;&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1D6;strokeColor=#D9930D;fontColor=#1A1A1A;fontSize=12;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="solution-1"><mxGeometry x="1333" y="759" width="82" height="19" as="geometry"/></mxCell><mxCell id="solution-title" value="Solution Architecture: Immigration Rules Q&amp;amp;A for International Students" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;fontSize=23;fontColor=#1A1A1A;fontFamily=Helvetica;align=left;fontStyle=1;" vertex="1" parent="solution-1"><mxGeometry x="14" y="10" width="980" height="36" as="geometry"/></mxCell><mxCell id="solution-lg-st" value="Status on Nov 24, 2026:" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;fontSize=13;fontColor=#333333;fontFamily=Helvetica;align=left;" vertex="1" parent="solution-1"><mxGeometry x="1030" y="19" width="150" height="19" as="geometry"/></mxCell><mxCell id="solution-bandtext-process" value="PROCESS" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;fontSize=17;fontColor=#333333;fontFamily=Helvetica;align=center;fontStyle=1;horizontal=0;" vertex="1" parent="solution-1"><mxGeometry x="12" y="56" width="44" height="290" as="geometry"/></mxCell><mxCell id="solution-bandtext-execution" value="EXECUTION" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=w