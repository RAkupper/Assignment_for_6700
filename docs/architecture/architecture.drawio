OST /retrieve&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12.5px&quot; color=&quot;#1A1A1A&quot;&gt;passages only; 30 a minute&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F6FBF7;strokeColor=#BBDCC5;fontColor=#1A1A1A;fontSize=12.5;strokeWidth=1.2;fontFamily=Helvetica;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="solution-1"><mxGeometry x="378" y="504" width="280" height="44" as="geometry"/></mxCell><mxCell id="solution-ep1-st" value="&lt;b&gt;&lt;font style=&quot;font-size: 11.5px&quot; color=&quot;#1F6B3A&quot;&gt;built&lt;/font&gt;&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F4E8;strokeColor=#3C9A5F;fontColor=#1A1A1A;fontSize=12;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="solution-1"><mxGeometry x="605" y="511" width="46" height="19" as="geometry"/></mxCell><mxCell id="solution-ep2" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot; color=&quot;#1A1A1A&quot;&gt;GET /health · /ready · /docs&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12.5px&quot; color=&quot;#1A1A1A&quot;&gt;process up · model + index loaded&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12.5px&quot; color=&quot;#1A1A1A&quot;&gt;· OpenAPI page&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F6FBF7;strokeColor=#BBDCC5;fontColor=#1A1A1A;fontSize=12.5;strokeWidth=1.2;fontFamily=Helvetica;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="solution-1"><mxGeometry x="378" y="554" width="280" height="60" as="geometry"/></mxCell><mxCell id="solution-ep2-st" value="&lt;b&gt;&lt;font style=&quot;font-size: 11.5px&quot; color=&quot;#1F6B3A&quot;&gt;built&lt;/font&gt;&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E3F4E8;strokeColor=#3C9A5F;fontColor=#1A1A1A;fontSize=12;