        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(app_answer_tokens_bucket[5m])))",
          "legendFormat": "p95"
        }
